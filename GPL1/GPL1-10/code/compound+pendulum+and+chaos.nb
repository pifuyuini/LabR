Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"duff", ",", "x", ",", "t"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"duff", "[", "t_", "]"}], "=", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
              RowBox[{"0.78", 
               RowBox[{
                RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
              RowBox[{"x", "[", "t", "]"}], "+", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "==", 
             RowBox[{"Cos", "[", 
              RowBox[{"m", "*", "t"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0.8"}]}], "}"}], 
          ",", 
          RowBox[{"x", "[", "t", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"duff", "[", "t", "]"}], ",", 
          RowBox[{
           RowBox[{"duff", "'"}], "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
        RowBox[{"AspectRatio", "\[Rule]", "1"}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
