Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tstep", " ", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Totalpoints", "=", "5000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Recordtime", "=", 
   RowBox[{"Tstep", "*", "Totalpoints"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Recordsignal", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"duff", "'"}], "[", 
      RowBox[{"n", "*", "Tstep"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "Totalpoints"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transform", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Fourier", "[", "Recordsignal", "]"}], "]"}], "^", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"frequencies", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"n", "/", "Recordtime"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "Totalpoints"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"frequencies", ",", "transform"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"data", ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0.7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "20"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Hz\>\"", ",", "Larger"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\:8c31\:5f3a\:5ea6\>\"", ",", "Larger"}], "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"AxesStyle", "\[Rule]", 
    RowBox[{"Directive", "[", "22", "]"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.839816275121359*^9, 3.8398167900725513`*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"b2f1a428-d174-42dd-b381-c821c333f5f1"],

