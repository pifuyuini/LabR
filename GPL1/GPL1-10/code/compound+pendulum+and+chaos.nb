    "\"\:65e0\:6807\:9898\"", Typeset`specs$$ = {{{
       Hold[$CellContext`m$$], 0.8}, 0.1, 1.8}}, Typeset`size$$ = {
    251.99999999999997`, {124., 127.99999999999997`}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`m$$ = 0.8}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`duff$, $CellContext`x$, $CellContext`t$}, \
$CellContext`duff$[
           Pattern[$CellContext`t$, 
            Blank[]]] = Part[
           
           NDSolve[{
            Derivative[2][$CellContext`x$][$CellContext`t$] + 
              0.78 Derivative[
                1][$CellContext`x$][$CellContext`t$] - \
$CellContext`x$[$CellContext`t$] + $CellContext`x$[$CellContext`t$]^3 == 
             Cos[$CellContext`m$$ $CellContext`t$], $CellContext`x$[0] == 0, 
             Derivative[1][$CellContext`x$][0] == 0.8}, 
            $CellContext`x$[$CellContext`t$], {$CellContext`t$, 0, 100}], 1, 
           1, 2]; ParametricPlot[{
           $CellContext`duff$[$CellContext`t$], 
           Derivative[
           1][$CellContext`duff$][$CellContext`t$]}, {$CellContext`t$, 0, 
           100}, AspectRatio -> 1]], 
      "Specifications" :> {{{$CellContext`m$$, 0.8}, 0.1, 1.8}}, 
