Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
  "\:4f7f\:7528LaTex\:5b57\:7b26\:4f5c\:4e3a\:53d8\:91cf\:6613\:5f15\:53d1\
BUG", "\:ff01", "\:ff01", "\:ff1b", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"duff", "[", "t_", "]"}], "=", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
            RowBox[{"0.75", "*", 
             RowBox[{
              RowBox[{"x", "'"}], "[", "t", "]"}]}], "-", 
            RowBox[{"x", "[", "t", "]"}], "+", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "==", 
           RowBox[{"Cos", "[", 
            RowBox[{"1.6", "*", "t"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
        RowBox[{"x", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "500"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"duff", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "500"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\!\(\*TemplateBox[Association[\"boxes\" -> FormBox[\"\[Tau]\", \
TraditionalForm], \"errors\" -> {}, \"input\" -> \"\\\\tau\", \"state\" -> \
\"Boxes\"],\"TeXAssistantTemplate\"]\)\>\"", ",", "Large"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<x\>\"", ",", "Larger"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"AxesStyle", "\[Rule]", 
    RowBox[{"Directive", "[", "22", "]"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.2"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"duff", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"duff", "'"}], "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "500"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<x\>\"", ",", "Large"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\!\(\*TemplateBox[Association[\"boxes\" -> FormBox[
FractionBox[
RowBox[{
StyleBox[\"d\", \"TI\"], 
StyleBox[\"x\", \"TI\"]}], 
RowBox[{
StyleBox[\"d\", \"TI\"], \"\[Tau]\"}]], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"\\\\frac{dx}{d\\\\tau}\", \"state\" -> \
\"Boxes\"],\"TeXAssistantTemplate\"]\)\>\"", ",", "Larger"}], "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.7"}], ",", 
   RowBox[{"AxesStyle", "\[Rule]", 
    RowBox[{"Directive", "[", "22", "]"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
